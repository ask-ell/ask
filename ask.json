{
    "extends": [
        {
            "id": "nx",
            "parameters": {
                "stack": "ask-ell_governance_ask",
                "packages": [
                    "cli"
                ],
                "libs": [
                    "back-end-api"
                ],
                "services": [
                    "back-end"
                ]
            }
        }
    ],
    "tasks": [
        {
            "id": "post:install",
            "description": "post install task",
            "instructions": [
                "@ask run build:cli",
                "mkdir -p tmp/ask"
            ]
        },
        {
            "id": "build:cli",
            "description": "build the CLI",
            "files": [
                "tmp/last_install"
            ],
            "instructions": [
                "nx build cli"
            ]
        }
    ]
}